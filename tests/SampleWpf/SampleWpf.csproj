    <UseWPF>true</UseWPF>
    <AssemblyName>SampleWpf</AssemblyName>
    <RootNamespace>SampleWpf</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
